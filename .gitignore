# ---- 厂商固件与内核二进制：体积大、版权归厂商，不随仓库分发 ----
# 需要的读者请从自己的设备转储后本地重建，见 firmware_F16/README.md
firmware_F16/*
!firmware_F16/README.md

# ---- 厂商 Windows 工具包（含 OPPO 官方 exe/dll、授权组件）----
REF/

# ---- 屏幕镜像工具（第三方发行版）----
scrcpy-win64-v3.3.4/

# ---- 构建产物与工具链（Zig 79 MB、交叉编译输出）----
.build/
*.o
*.elf
!firmware_F16/README.md

# ---- 本轮 Binder 审计拉取的厂商专有二进制：版权归 OPPO，不随公开仓库分发 ----
# 保留审计脚本(*.py)、文本报告(*.md/*.txt)；读者可从自己设备 adb pull 后本地重跑
artifacts_adb/binder_audit/jars/
artifacts_adb/binder_audit/dex/
artifacts_adb/binder_audit/atlas/*.apk
artifacts_adb/binder_audit/atlas/*.so
artifacts_adb/binder_audit/atlas/apk_dex/
# 第五轮 OTA 重建产物（system.new.dat.br 2.6G / .dat 4.8G / system.img 4.8G / 提取的二进制）
artifacts_adb/binder_audit/rootbin/*.br
artifacts_adb/binder_audit/rootbin/*.dat
artifacts_adb/binder_audit/rootbin/*.img
artifacts_adb/binder_audit/rootbin/_extract/
# P2 七服务审计从 system.img 提取的厂商二进制（同 _extract，不入库）
artifacts_adb/binder_audit/rootbin/_p2/

# ---- 第三方完整利用代码：不重新分发，只在文档中引用出处 ----
src_ref/poc_ex.c
src_ref/*.b64
# v007 预研克隆的 PCKM00 参考项目（第三方 GPL 代码，仅本地只读比对，不入库）
ref_pc/
# 真机探针的交叉编译产物（只推 .c 源码，二进制体积大且平台相关）
live_probe/timer_probe
live_probe/collision_probe

# ---- 会话/编辑器临时文件 ----
.workbuddy/
.vscode/
.DS_Store
Thumbs.db
*.log.tmp

# Python 缓存
__pycache__/
*.pyc

# ---- v4/v5 真机探针交叉编译产物（只推 .c 源码）----
live_probe/perf_probe
live_probe/spray_probe
live_probe/e2e_probe
live_probe/e2e2_probe
live_probe/same_bucket_probe
live_probe/calib_probe
live_probe/transfer_probe
live_probe/transfer2_probe

# ---- 探针编译产物（aarch64 静态二进制，由 *.c 可重建）与运行日志 ----
live_probe/*
!live_probe/*.c
!live_probe/*.md
!live_probe/*.txt
